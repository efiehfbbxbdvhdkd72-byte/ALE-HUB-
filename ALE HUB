-- Bucle para animación de la Intro
task.spawn(function()
    local connection
    local fadingOut = false
    
    connection = RunService.RenderStepped:Connect(function()
        local currentTime = IntroSound.TimePosition
        
        if not fadingOut then
            local hue = tick() % 5 / 5
            TerrorText.TextColor3 = Color3.fromHSV(hue, 1, 1)
        end
        
        if (currentTime >= 13 or not IntroSound.IsPlaying) and not fadingOut then
            fadingOut = true
            local tweenInfo = TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            
            local bgTween = TweenService:Create(Background, tweenInfo, {BackgroundTransparency = 1})
            local textTween = TweenService:Create(TerrorText, tweenInfo, {TextTransparency = 1, TextStrokeTransparency = 1})
            
            bgTween:Play()
            textTween:Play()
            
            for _, pumpkin in ipairs(PumpkinContainer:GetChildren()) do
                if pumpkin:IsA("TextLabel") then
                    TweenService:Create(pumpkin, tweenInfo, {TextTransparency = 1}):Play()
                end
            end
            
            IntroSound:Stop()
            
            task.delay(1.2, function()
                IntroSound:Destroy()
                IntroGui:Destroy()
            end)
            
            connection:Disconnect()
        end
    end)
end)

