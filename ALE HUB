    local buttonsData = {
        "C", "(", ")", "÷",
        "7", "8", "9", "×",
        "4", "5", "6", "-",
        "1", "2", "3", "+",
        "0", ".", "%", "="
    }

    for _, text in ipairs(buttonsData) do
        local Btn = Instance.new("TextButton")
        Btn.Size = UDim2.new(0, 0, 0, 0)
        Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
        Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        Btn.TextSize = 16
        Btn.Font = Enum.Font.GothamBold
        Btn.Text = text
        Btn.Parent = ButtonsGrid

        local BtnCorner = Instance.new("UICorner")
        BtnCorner.CornerRadius = UDim.new(0, 6)
        BtnCorner.Parent = Btn

        Btn.MouseButton1Click:Connect(function()
            playSound("6895079853")

            if text == "C" then
                Display.Text = ""
            elseif text == "=" then
                local success, result = pcall(function()
                    local expression = Display.Text
                    expression = string.gsub(expression, "÷", "/")
                    expression = string.gsub(expression, "×", "*")
                    expression = string.gsub(expression, "%%", "/100")

                    local func = loadstring("return " .. expression)
                    if func then
                        return func()
                    end
                    error("Expresión inválida")
                end)

                if success and result ~= nil then
                    Display.Text = tostring(result)
                else
                    Display.Text = "Error"
                end
            else
                Display.Text = Display.Text .. text
            end
        end)
    end
end

