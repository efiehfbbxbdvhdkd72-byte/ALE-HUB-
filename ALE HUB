local function getAIResponse(question)
    local q = string.lower(question)
    
    -- 1. Privacidad del creador
    if string.find(q, "creó") or string.find(q, "creador") or string.find(q, "id") or string.find(q, "quien te hizo") or string.find(q, "quien te programó") then
        return "[COLOR_RED]No puedo decir quién me creó, porque es privado."

    -- 2. Preguntas específicas de planetas (Ordenadas de más específica a más general para evitar cruces)
    elseif string.find(q, "planeta más grande") or string.find(q, "planeta grande") or string.find(q, "cual es el mas grande") then
        return "¡Júpiter es el planeta más grande del sistema solar! Es un gigante gaseoso tan inmenso que en su interior cabrían más de 1,300 planetas Tierra."
    elseif string.find(q, "cuántos planetas") or string.find(q, "cuantos planetas") or string.find(q, "número de planetas") then
        return "En nuestro sistema solar hay 8 planetas oficiales: Mercurio, Venus, Tierra, Marte, Júpiter, Saturno, Urano y Neptuno."
    elseif string.find(q, "marte") then
        return "Marte es conocido como 'el planeta rojo' debido al óxido de hierro (herrumbre) que abunda en su superficie. ¡Es el objetivo principal de la exploración espacial!"
    elseif string.find(q, "saturno") then
        return "Saturno es el famoso planeta de los anillos espectaculares, formados principalmente por millones de fragmentos de hielo y roca."
    elseif string.find(q, "venus") then
        return "Venus es el planeta más caliente del sistema solar debido a su densa atmósfera de dióxido de carbono que atrapa todo el calor."
    elseif string.find(q, "urano") then
        return "Urano es un gigante helado muy peculiar, ¡porque gira completamente de lado sobre su órbita!"
    elseif string.find(q, "neptuno") then
        return "Neptuno es el gigante gaseoso más lejano del Sol, azotado por los vientos más furiosos y rápidos de todo el sistema solar."
    elseif string.find(q, "mercurio") then
        return "Mercurio es el planeta más cercano al Sol y también el más pequeño de los planetas rocosos."
    elseif string.find(q, "tierra") and (string.find(q, "planeta") or string.find(q, "nuestro")) then
        return "La Tierra es nuestro hogar, el tercer planeta desde el Sol y el único lugar conocido con vida gracias a su agua líquida."
    elseif string.find(q, "plutón") or string.find(q, "pluton") then
        return "Plutón fue considerado el noveno planeta, pero en 2006 la Unión Astronómica Internacional lo redefinió como un 'planeta enano'."
    elseif string.find(q, "sistema solar") then
        return "El sistema solar está formado por el Sol y todos los cuerpos que giran a su alrededor: 8 planetas principales, lunas, asteroides y cometas."
    elseif string.find(q, "planeta") or string.find(q, "espacio") or string.find(q, "galaxia") or string.find(q, "universo") or string.find(q, "estrella") then
        return "¡El espacio exterior es increíble! El universo está lleno de galaxias, estrellas y mundos fascinantes. ¿Qué te gustaría saber sobre algún planeta en específico?"

    -- 3. Otros temas generales
    elseif string.find(q, "fede") or string.find(q, "vigevani") then
        return "Fede Vigevani es un famoso creador de contenido, influencer y músico uruguayo conocido por sus retos y videos de terror."
    elseif string.find(q, "huesos") and string.find(q, "cuerpo") then
        return "El cuerpo humano de un adulto tiene exactamente 206 huesos que forman el esqueleto."
    elseif string.find(q, "hola") or string.find(q, "saludos") or string.find(q, "buenas") then
        return "¡Hola! Soy ALE AI, tu asistente inteligente. Pregúntame lo que quieras sobre ciencia, tecnología o sobre tus planetas favoritos."
    elseif string.find(q, "tu nombre") or string.find(q, "quien eres") then
        return "Soy ALE AI, una inteligencia artificial avanzada diseñada para ayudarte y responder cualquier duda que tengas."
    elseif string.find(q, "roblox") then
        return "Roblox es una plataforma en línea y sistema de creación de juegos donde los usuarios pueden programar y jugar mundos virtuales."
    else
        return "Esa es una excelente pregunta sobre '" .. question .. "'. Desde mi perspectiva como IA, es un tema fascinante. ¿Te refieres a algo de ciencia, espacio o tienes otra duda?"
    end
end

